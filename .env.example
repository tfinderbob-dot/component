PORT=4000
HOST=127.0.0.1
# demo uses a local JSON file. mysql never silently falls back to demo.
STORAGE_MODE=demo
DEMO_SEED=true
ADMIN_EMAIL=admin@componentcare.local
# Required in MySQL mode. Choose your own strong password before database setup.
ADMIN_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=component_care
MYSQL_USER=componentcare
MYSQL_PASSWORD=
COOKIE_SECURE=false
# Set to loopback only when a local reverse proxy forwards the HTTPS domain.
TRUST_PROXY=
# For deployment, set an absolute persistent directory outside the web document root.
ATTACHMENT_DIR=
